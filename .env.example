PORT=3000
JWT_SECRET=change_this_secret_in_production
NODE_ENV=development

# Необязательно: ИИ-агент поиска по форумам (server/services/forumSearch.js).
# Без этих переменных агент работает в режиме локальной базы знаний.
# Если указать совместимый с контрактом { results: [{title,url,snippet}] } JSON API —
# агент будет реально искать во внешних источниках.
# SEARCH_API_URL=https://api.example.com/search
# SEARCH_API_KEY=your_api_key
